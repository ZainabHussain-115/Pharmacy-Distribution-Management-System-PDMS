@{
    ViewData["Title"] = "Welcome";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PDMS — Pharmacy Distribution Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #0f172a 100%);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Segoe UI', sans-serif; overflow: hidden;
        }
        .bg-particles { position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:0; }
        .particle { position:absolute; border-radius:50%; background:rgba(78,154,241,0.07); animation: floatUp linear infinite; }
        .landing-wrap { position:relative; z-index:1; text-align:center; padding:2rem; max-width:700px; width:100%; }
        .logo-pill {
            display:inline-flex; align-items:center; gap:12px;
            background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12);
            border-radius:999px; padding:10px 24px; margin-bottom:2rem; backdrop-filter:blur(10px);
        }
        .logo-text { font-size:1.1rem; font-weight:700; color:#fff; letter-spacing:.05em; }
        .logo-text span { color:#4e9af1; }
        .main-title { font-size:3rem; font-weight:800; color:#fff; line-height:1.2; margin-bottom:1rem; }
        .highlight { background:linear-gradient(90deg,#4e9af1,#38d9a9); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
        .subtitle { font-size:1.05rem; color:rgba(255,255,255,0.5); margin-bottom:2.5rem; line-height:1.7; }
        .btn-enter {
            padding:14px 40px; font-size:1rem; font-weight:600; border-radius:999px; border:none;
            background:linear-gradient(135deg,#4e9af1,#2b7de9); color:#fff;
            box-shadow:0 8px 30px rgba(78,154,241,0.35);
            text-decoration:none; display:inline-flex; align-items:center; gap:8px; transition:all 0.2s;
        }
        .btn-enter:hover { transform:translateY(-2px); box-shadow:0 12px 40px rgba(78,154,241,0.5); color:#fff; }
        .features { display:flex; justify-content:center; gap:1.2rem; margin-top:3rem; flex-wrap:wrap; }
        .feature-card {
            background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08);
            border-radius:16px; padding:1.2rem 1.4rem; width:150px; text-align:center;
            backdrop-filter:blur(10px); transition:all 0.2s;
        }
        .feature-card:hover { background:rgba(255,255,255,0.08); transform:translateY(-4px); }
        .feature-icon { font-size:1.8rem; margin-bottom:.4rem; }
        .feature-title { font-size:.78rem; color:rgba(255,255,255,0.55); font-weight:500; }
        .footer-note { margin-top:2.5rem; font-size:.75rem; color:rgba(255,255,255,0.2); }
    </style>
</head>
<body>
<div class="bg-particles" id="particles"></div>
<div class="landing-wrap">
    <div class="logo-pill">
        <span style="font-size:1.8rem">💊</span>
        <span class="logo-text"><span>PD</span>MS</span>
    </div>
    <div class="main-title">
        Pharmacy Distribution<br>
        <span class="highlight">Management System</span>
    </div>
    <p class="subtitle">
        Complete inventory, sales &amp; reporting solution<br>
        for modern pharmacy distribution businesses.
    </p>
    <a href="/Auth/Login" class="btn-enter">
        <i class="bi bi-box-arrow-in-right"></i> Enter System
    </a>
    <div class="features">
        <div class="feature-card"><div class="feature-icon">📦</div><div class="feature-title">Batch Tracking</div></div>
        <div class="feature-card"><div class="feature-icon">🧾</div><div class="feature-title">Sales &amp; Invoicing</div></div>
        <div class="feature-card"><div class="feature-icon">📊</div><div class="feature-title">Analytics</div></div>
        <div class="feature-card"><div class="feature-icon">⚠️</div><div class="feature-title">Expiry Alerts</div></div>
        <div class="feature-card"><div class="feature-icon">🔐</div><div class="feature-title">Role Based Access</div></div>
    </div>
    <div class="footer-note">4th Semester Database Project &nbsp;·&nbsp; ASP.NET MVC + SQL Server 2019</div>
</div>

<!-- @@keyframes uses @@ so Razor does not parse it as C# -->
<style>
    @@keyframes floatUp {
        0%   { transform: translateY(100vh) rotate(0deg);    opacity: 0; }
        10%  { opacity: 1; }
        90%  { opacity: 1; }
        100% { transform: translateY(-100px) rotate(720deg); opacity: 0; }
    }
</style>

<script>
    var container = document.getElementById('particles');
    for (var i = 0; i < 18; i++) {
        var p = document.createElement('div');
        p.className = 'particle';
        var size = Math.random() * 80 + 20;
        p.style.width            = size + 'px';
        p.style.height           = size + 'px';
        p.style.left             = (Math.random() * 100) + '%';
        p.style.animationDuration = (Math.random() * 15 + 10) + 's';
        p.style.animationDelay   = (Math.random() * 10) + 's';
        container.appendChild(p);
    }
</script>
</body>
</html>
