@{ ViewData["Title"] = "Reports"; }

<div class="page-title"><i class="bi bi-bar-chart-line me-2"></i>Reports & Analytics</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-2">🏆</div>
                <h5 class="fw-semibold">Medicine of the Month</h5>
                <p class="text-muted small">Top selling medicine by quantity each month</p>
                <a asp-action="MedicineOfMonth" class="btn btn-primary btn-sm">View Report</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-2">👑</div>
                <h5 class="fw-semibold">Customer of the Month</h5>
                <p class="text-muted small">Top customer by spending each month</p>
                <a asp-action="CustomerOfMonth" class="btn btn-primary btn-sm">View Report</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-2">📈</div>
                <h5 class="fw-semibold">Monthly Revenue</h5>
                <p class="text-muted small">Month by month sales and revenue for any year</p>
                <a asp-action="MonthlyRevenue" class="btn btn-primary btn-sm">View Report</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-2">💰</div>
                <h5 class="fw-semibold">Overall Profit</h5>
                <p class="text-muted small">Total revenue, cost, profit and profit margin</p>
                <a asp-action="OverallProfit" class="btn btn-primary btn-sm">View Report</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-2">⚠️</div>
                <h5 class="fw-semibold">Low Stock Alert</h5>
                <p class="text-muted small">Medicines below reorder level</p>
                <a asp-action="LowStock" class="btn btn-warning btn-sm">View Report</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-2">📅</div>
                <h5 class="fw-semibold">Expiry Report</h5>
                <p class="text-muted small">Expiring and already expired medicines</p>
                <a asp-action="ExpiryReport" class="btn btn-danger btn-sm">View Report</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-2">🗓️</div>
                <h5 class="fw-semibold">Sales by Date Range</h5>
                <p class="text-muted small">Filter all sales between any two dates</p>
                <a asp-action="SalesByDate" class="btn btn-primary btn-sm">View Report</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-2">👤</div>
                <h5 class="fw-semibold">Customer History</h5>
                <p class="text-muted small">Full purchase history of any customer</p>
                <a asp-action="CustomerHistory" class="btn btn-primary btn-sm">View Report</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-2">💊</div>
                <h5 class="fw-semibold">Best Selling Medicines</h5>
                <p class="text-muted small">Top 10 medicines by all-time quantity sold</p>
                <a asp-action="BestSelling" class="btn btn-primary btn-sm">View Report</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-2">🏪</div>
                <h5 class="fw-semibold">Stock Valuation</h5>
                <p class="text-muted small">Current inventory cost value vs sale value</p>
                <a asp-action="StockValuation" class="btn btn-success btn-sm">View Report</a>
            </div>
        </div>
    </div>
</div>
