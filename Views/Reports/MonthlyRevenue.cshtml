@{ ViewData["Title"] = "Monthly Revenue"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="page-title mb-0">📈 Monthly Revenue Report</div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← All Reports</a>
</div>

<div class="card mb-3"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label fw-semibold">Year</label>
            <select name="year" class="form-select form-select-sm">
                @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 3; y--)
                { <option value="@y" selected="@(y == (int)ViewBag.Year)">@y</option> }
            </select>
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-primary btn-sm">Filter</button></div>
    </form>
</div></div>

@{
    decimal yearTotal = (decimal?)ViewBag.TotalYearRevenue ?? 0m;
    var reportList = ((IEnumerable<dynamic>)ViewBag.ReportData)?.ToList();

    decimal maxRev = 1m;
    if (reportList != null)
    {
        foreach (var r in reportList)
        {
            decimal rv = (decimal?)r.TotalRevenue ?? 0m;
            if (rv > maxRev) maxRev = rv;
        }
    }
}

<div class="card mb-3 border-success">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <div class="text-muted small">Total Revenue for @ViewBag.Year</div>
            <div class="fs-3 fw-bold text-success">Rs. @yearTotal.ToString("N2")</div>
        </div>
        <div class="fs-1">💰</div>
    </div>
</div>

<div class="card"><div class="card-body p-0">
    <table class="table table-hover mb-0">
        <thead><tr><th>Month</th><th>Total Sales</th><th>Revenue</th><th>Discount Given</th><th>Progress</th></tr></thead>
        <tbody>
            @if (reportList != null && reportList.Count > 0)
            {
                @foreach (var item in reportList)
                {
                    decimal rev      = (decimal?)item.TotalRevenue  ?? 0m;
                    decimal discount = (decimal?)item.TotalDiscount ?? 0m;
                    decimal pct      = maxRev > 0 ? rev / maxRev * 100 : 0;
                    string monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName((int)item.Month);
                    <tr>
                        <td class="fw-semibold">@monthName</td>
                        <td>@item.TotalSales</td>
                        <td>Rs. @rev.ToString("N2")</td>
                        <td>Rs. @discount.ToString("N2")</td>
                        <td style="min-width:150px">
                            <div class="progress" style="height:8px">
                                <div class="progress-bar bg-success" style="width:@pct%"></div>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5" class="text-center text-muted py-4">No sales data for @ViewBag.Year.</td></tr>
            }
        </tbody>
    </table>
</div></div>
