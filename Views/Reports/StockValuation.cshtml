@{ ViewData["Title"] = "Stock Valuation"; }

@functions {
    string F(object val) => val == null ? "0.00" : ((decimal)val).ToString("N2");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="page-title mb-0">🏪 Stock Valuation Report</div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← All Reports</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center p-3 border-danger">
            <div class="text-muted small">Total Cost Value (Purchase Price)</div>
            <div class="fs-4 fw-bold text-danger">Rs. @F(ViewBag.TotalCostValue)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3 border-success">
            <div class="text-muted small">Total Sale Value (Selling Price)</div>
            <div class="fs-4 fw-bold text-success">Rs. @F(ViewBag.TotalSaleValue)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3 border-primary">
            <div class="text-muted small">Potential Profit (if all sold)</div>
            <div class="fs-4 fw-bold text-primary">Rs. @F(ViewBag.PotentialProfit)</div>
        </div>
    </div>
</div>

<div class="card"><div class="card-body p-0">
    <table class="table table-hover mb-0">
        <thead><tr><th>Medicine</th><th>Batch</th><th>Warehouse</th><th>Qty</th><th>Purchase Price</th><th>Selling Price</th><th>Cost Value</th><th>Sale Value</th><th>Expiry</th></tr></thead>
        <tbody>
            @foreach (var item in ViewBag.ReportData)
            {
                decimal costVal = (decimal?)item.CostValue ?? 0m;
                decimal saleVal = (decimal?)item.SaleValue ?? 0m;
                decimal purPrice = (decimal?)item.PurchasePrice ?? 0m;
                decimal selPrice = (decimal?)item.SellingPrice ?? 0m;
                DateTime exp = (DateTime)item.ExpiryDate;
                <tr>
                    <td class="fw-semibold">@item.MedicineName</td>
                    <td>@item.BatchNumber</td>
                    <td>@item.WarehouseName</td>
                    <td>@item.QuantityAvailable</td>
                    <td>Rs. @purPrice.ToString("N2")</td>
                    <td>Rs. @selPrice.ToString("N2")</td>
                    <td class="text-danger">Rs. @costVal.ToString("N2")</td>
                    <td class="text-success fw-semibold">Rs. @saleVal.ToString("N2")</td>
                    <td>
                        @if (exp < DateTime.Today) { <span class="badge bg-danger">Expired</span> }
                        else if (exp < DateTime.Today.AddDays(90)) { <span class="badge bg-warning text-dark">@exp.ToString("yyyy-MM-dd")</span> }
                        else { <span class="text-muted small">@exp.ToString("yyyy-MM-dd")</span> }
                    </td>
                </tr>
            }
            @if (ViewBag.ReportData == null || Enumerable.Count(ViewBag.ReportData) == 0)
            { <tr><td colspan="9" class="text-center text-muted py-4">No stock data found.</td></tr> }
        </tbody>
    </table>
</div></div>
