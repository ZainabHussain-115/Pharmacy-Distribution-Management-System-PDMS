@{ ViewData["Title"] = "Sales by Date Range"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="page-title mb-0">🗓️ Sales by Date Range</div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← All Reports</a>
</div>

<div class="card mb-3"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label fw-semibold">From</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control form-control-sm" />
        </div>
        <div class="col-auto">
            <label class="form-label fw-semibold">To</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control form-control-sm" />
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-primary btn-sm">Filter</button></div>
    </form>
</div></div>

@{
    decimal totalRev = (decimal?)ViewBag.TotalRevenue ?? 0m;
}

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card text-center p-3">
            <div class="text-muted small">Total Sales</div>
            <div class="fs-3 fw-bold text-primary">@ViewBag.TotalSales</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3">
            <div class="text-muted small">Total Revenue</div>
            <div class="fs-3 fw-bold text-success">Rs. @totalRev.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="card"><div class="card-body p-0">
    <table class="table table-hover mb-0">
        <thead><tr><th>Sale #</th><th>Customer</th><th>Staff</th><th>Date</th><th>Net Amount</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var s in ViewBag.Sales)
            {
                decimal net = (decimal?)s.NetAmount ?? 0m;
                <tr>
                    <td>#@s.SaleID</td>
                    <td>@s.Customer?.Name</td>
                    <td>@s.User?.FullName</td>
                    <td>@s.SaleDate.ToString("yyyy-MM-dd")</td>
                    <td class="fw-semibold">Rs. @net.ToString("N2")</td>
                    <td>
                        @if (s.PaymentStatus == "Paid") { <span class="badge badge-ok">Paid</span> }
                        else { <span class="badge badge-low">Pending</span> }
                    </td>
                </tr>
            }
            @if (ViewBag.Sales == null || Enumerable.Count(ViewBag.Sales) == 0)
            { <tr><td colspan="6" class="text-center text-muted py-4">No sales in this date range.</td></tr> }
        </tbody>
    </table>
</div></div>
