@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Access Denied — PDMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f8f9fa; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .card { border: none; border-radius: 20px; box-shadow: 0 8px 40px rgba(0,0,0,0.1); max-width: 480px; width: 100%; text-align: center; padding: 3rem 2rem; }
        .icon { font-size: 5rem; margin-bottom: 1rem; }
        .badge-role { font-size: 0.75rem; padding: 4px 12px; border-radius: 99px; }
    </style>
</head>
<body>
<div class="card">
    <div class="icon">🔒</div>
    <h3 class="fw-bold text-danger mb-2">Access Denied</h3>
    <p class="text-muted mb-3">
        You don't have permission to view this page.<br>
        This section is restricted to <strong>Administrators</strong> only.
    </p>
    <div class="mb-4">
        <span class="badge bg-warning text-dark badge-role">
            Your Role: @(Context.Session.GetString("Role") ?? "Staff")
        </span>
    </div>
    <div class="d-flex gap-2 justify-content-center">
        <a href="/Home/Index" class="btn btn-primary">← Back to Dashboard</a>
        <a href="/Auth/Logout" class="btn btn-outline-secondary">Logout</a>
    </div>
    <p class="text-muted mt-3" style="font-size:0.78rem">
        If you think this is a mistake, contact your system administrator.
    </p>
</div>
</body>
</html>
