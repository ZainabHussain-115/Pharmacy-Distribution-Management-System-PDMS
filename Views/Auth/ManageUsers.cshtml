@model IEnumerable<PDMS.Models.User>
@{ ViewData["Title"] = "Manage Users"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="page-title mb-0"><i class="bi bi-people-fill me-2"></i>Manage Users</div>
    <a asp-action="AddUser" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add User</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>#</th><th>Full Name</th><th>Username</th><th>Role</th><th>Status</th><th>Created</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr class="@(!u.IsActive ? "table-secondary text-muted" : "")">
                        <td>@u.UserID</td>
                        <td class="fw-semibold">@u.FullName</td>
                        <td><code>@u.Username</code></td>
                        <td>
                            @if (u.Role == "Admin")
                            { <span class="badge bg-warning text-dark">👑 Admin</span> }
                            else
                            { <span class="badge bg-info text-dark">👤 Staff</span> }
                        </td>
                        <td>
                            @if (u.IsActive)
                            { <span class="badge badge-ok">Active</span> }
                            else
                            { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                        <td>@u.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>
                            <!-- Toggle Active/Inactive -->
                            <form asp-action="ToggleUser" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@u.UserID" />
                                <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success") btn-action me-1"
                                        title="@(u.IsActive ? "Deactivate" : "Activate")">
                                    <i class="bi @(u.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                </button>
                            </form>

                            <!-- Reset Password -->
                            <button class="btn btn-outline-secondary btn-action btn-sm"
                                    onclick="showReset(@u.UserID, '@u.FullName')"
                                    title="Reset Password">
                                <i class="bi bi-key"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                { <tr><td colspan="7" class="text-center text-muted py-4">No users found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">Reset Password</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ResetPassword" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" id="resetUserId" />
                    <p class="text-muted small mb-2">Reset password for: <strong id="resetUserName"></strong></p>
                    <input type="password" name="newPassword" class="form-control" placeholder="New password" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function showReset(id, name) {
    document.getElementById('resetUserId').value   = id;
    document.getElementById('resetUserName').textContent = name;
    new bootstrap.Modal(document.getElementById('resetModal')).show();
}
</script>
}
