@model PDMS.Models.User
@{ ViewData["Title"] = "Add User"; }

<div class="page-title"><i class="bi bi-person-plus me-2"></i>Add New User</div>

<div class="card" style="max-width:500px;">
    <div class="card-body">
        <form asp-action="AddUser" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="e.g. Zainab Khan" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-semibold">Username</label>
                <input asp-for="Username" class="form-control" placeholder="e.g. zainab01" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Password</label>
                <input type="password" name="password" class="form-control" placeholder="Set a strong password" required />
            </div>

            <div class="mb-4">
                <label asp-for="Role" class="form-label fw-semibold">Role</label>
                <select asp-for="Role" class="form-select">
                    <option value="Staff">👤 Staff — Limited access</option>
                    <option value="Admin">👑 Admin — Full access</option>
                </select>
                <div class="form-text">
                    <strong>Staff:</strong> Can create sales, add batches, view basic reports.<br>
                    <strong>Admin:</strong> Full access including profit reports, user management, delete operations.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create User</button>
                <a asp-action="ManageUsers" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
