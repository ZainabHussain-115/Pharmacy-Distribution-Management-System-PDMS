@model PDMS.Models.Medicine
@{ ViewData["Title"] = "Delete Medicine"; }

<div class="page-title text-danger"><i class="bi bi-trash me-2"></i>Delete Medicine</div>
<div class="card" style="max-width:500px;">
    <div class="card-body">
        <div class="alert alert-danger">Are you sure you want to delete <strong>@Model.Name</strong>?</div>
        <dl class="row">
            <dt class="col-sm-4">Name</dt>         <dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">Generic</dt>       <dd class="col-sm-8">@Model.GenericName</dd>
            <dt class="col-sm-4">Manufacturer</dt>  <dd class="col-sm-8">@Model.Manufacturer?.Name</dd>
        </dl>
        <form asp-action="Delete">
            <input type="hidden" asp-for="MedicineID" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
