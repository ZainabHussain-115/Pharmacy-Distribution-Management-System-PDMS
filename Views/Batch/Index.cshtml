@model IEnumerable<PDMS.Models.Batch>
@{ ViewData["Title"] = "Batches"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="page-title mb-0"><i class="bi bi-layers me-2"></i>Batches</div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Batch</a>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead><tr><th>#</th><th>Medicine</th><th>Warehouse</th><th>Batch No</th><th>Mfg Date</th><th>Expiry</th><th>Received</th><th>Available</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.BatchID</td>
                        <td class="fw-semibold">@b.Medicine?.Name</td>
                        <td>@b.Warehouse?.Name</td>
                        <td>@b.BatchNumber</td>
                        <td>@b.ManufacturingDate.ToString("yyyy-MM-dd")</td>
                        <td>@b.ExpiryDate.ToString("yyyy-MM-dd")</td>
                        <td>@b.QuantityReceived</td>
                        <td>@b.QuantityAvailable</td>
                        <td>
                            @if (b.IsExpired)
                            { <span class="badge badge-expired">Expired</span> }
                            else if (b.IsLowStock)
                            { <span class="badge badge-low">Low Stock</span> }
                            else
                            { <span class="badge badge-ok">OK</span> }
                        </td>
                        <td>
                            <a asp-action="Edit"   asp-route-id="@b.BatchID" class="btn btn-outline-primary btn-action me-1"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@b.BatchID" class="btn btn-outline-danger  btn-action"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="10" class="text-center text-muted py-4">No batches yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
