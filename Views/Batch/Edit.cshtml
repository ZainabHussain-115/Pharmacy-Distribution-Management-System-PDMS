@model PDMS.Models.Batch
@{ ViewData["Title"] = "Edit Batch"; }

<div class="page-title"><i class="bi bi-pencil me-2"></i>Edit Batch</div>
<div class="card" style="max-width:650px;"><div class="card-body">
    <form asp-action="Edit">
        <input type="hidden" asp-for="BatchID" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row">
            <div class="col mb-3">
                <label asp-for="MedicineID" class="form-label fw-semibold"></label>
                <select asp-for="MedicineID" asp-items="ViewBag.Medicines" class="form-select"></select>
            </div>
            <div class="col mb-3">
                <label asp-for="WarehouseID" class="form-label fw-semibold"></label>
                <select asp-for="WarehouseID" asp-items="ViewBag.Warehouses" class="form-select"></select>
            </div>
        </div>
        <div class="mb-3"><label asp-for="BatchNumber"      class="form-label fw-semibold"></label><input asp-for="BatchNumber"      class="form-control" /></div>
        <div class="row">
            <div class="col mb-3"><label asp-for="ManufacturingDate" class="form-label fw-semibold"></label><input asp-for="ManufacturingDate" class="form-control" type="date" /></div>
            <div class="col mb-3"><label asp-for="ExpiryDate"        class="form-label fw-semibold"></label><input asp-for="ExpiryDate"        class="form-control" type="date" /></div>
        </div>
        <div class="row">
            <div class="col mb-3"><label asp-for="QuantityReceived"  class="form-label fw-semibold"></label><input asp-for="QuantityReceived"  class="form-control" type="number" /></div>
            <div class="col mb-4"><label asp-for="QuantityAvailable" class="form-label fw-semibold"></label><input asp-for="QuantityAvailable" class="form-control" type="number" /></div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Update</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>
