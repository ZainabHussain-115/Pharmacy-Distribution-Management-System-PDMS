@model PDMS.Models.Batch
@{ ViewData["Title"] = "Delete Batch"; }
<div class="page-title text-danger"><i class="bi bi-trash me-2"></i>Delete Batch</div>
<div class="card" style="max-width:500px;"><div class="card-body">
    <div class="alert alert-danger">Delete batch <strong>@Model.BatchNumber</strong> for <strong>@Model.Medicine?.Name</strong>?</div>
    <dl class="row">
        <dt class="col-4">Qty Available</dt><dd class="col-8">@Model.QuantityAvailable</dd>
        <dt class="col-4">Expiry</dt>       <dd class="col-8">@Model.ExpiryDate.ToString("yyyy-MM-dd")</dd>
    </dl>
    <form asp-action="Delete"><input type="hidden" asp-for="BatchID" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>
