@{
    ViewData["Title"] = "Dashboard";
    string role = ViewBag.Role ?? "Staff";
    bool isAdmin = role == "Admin";
}

<div class="page-title"><i class="bi bi-speedometer2 me-2"></i>Dashboard</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small mb-1">Total Medicines</div>
            <div class="fs-3 fw-bold text-primary">@(ViewBag.TotalMedicines ?? 0)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small mb-1">Total Customers</div>
            <div class="fs-3 fw-bold text-success">@(ViewBag.TotalCustomers ?? 0)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small mb-1">Total Sales</div>
            <div class="fs-3 fw-bold text-warning">@(ViewBag.TotalSales ?? 0)</div>
        </div>
    </div>
    <div class="col-md-3">
        @if (isAdmin)
        {
            <div class="card p-3">
                <div class="text-muted small mb-1">Total Revenue</div>
                @{ decimal rev = (decimal?)ViewBag.TotalRevenue ?? 0m; }
                <div class="fs-3 fw-bold text-danger">Rs. @rev.ToString("N0")</div>
            </div>
        }
        else
        {
            <div class="card p-3">
                <div class="text-muted small mb-1">Manufacturers</div>
                <div class="fs-3 fw-bold text-info">@(ViewBag.TotalManufacturers ?? 0)</div>
            </div>
        }
    </div>
</div>

@if (isAdmin)
{
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card p-3 border-success">
                <div class="text-muted small mb-1">Total Profit (Est.)</div>
                @{ decimal profit = (decimal?)ViewBag.TotalProfit ?? 0m; }
                <div class="fs-4 fw-bold text-success">Rs. @profit.ToString("N0")</div>
            </div>
        </div>
    </div>
}

<div class="row g-3">
    <!-- Low Stock -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Low Stock Batches
            </div>
            <div class="card-body p-0">
                @{
                    var lowStock = ViewBag.LowStockBatches as List<PDMS.Models.Batch>;
                }
                @if (lowStock != null && lowStock.Count > 0)
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Medicine</th><th>Warehouse</th><th>Qty Left</th></tr></thead>
                        <tbody>
                            @foreach (var b in lowStock)
                            {
                                <tr>
                                    <td>@b.Medicine?.Name</td>
                                    <td>@b.Warehouse?.Name</td>
                                    <td><span class="badge badge-low">@b.QuantityAvailable</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">No low stock items.</p>
                }
            </div>
        </div>
    </div>

    <!-- Expiring Soon -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-calendar-x-fill text-danger me-2"></i>Expiring Within 90 Days
            </div>
            <div class="card-body p-0">
                @{
                    var expiring = ViewBag.ExpiringBatches as List<PDMS.Models.Batch>;
                }
                @if (expiring != null && expiring.Count > 0)
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Medicine</th><th>Batch</th><th>Expiry</th></tr></thead>
                        <tbody>
                            @foreach (var b in expiring)
                            {
                                <tr>
                                    <td>@b.Medicine?.Name</td>
                                    <td>@b.BatchNumber</td>
                                    <td><span class="badge badge-expired">@b.ExpiryDate.ToString("yyyy-MM-dd")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">No medicines expiring soon.</p>
                }
            </div>
        </div>
    </div>

    <!-- Recent Sales -->
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-receipt me-2"></i>
                @(isAdmin ? "Recent Sales (All)" : "My Recent Sales")
            </div>
            <div class="card-body p-0">
                @{
                    var recentSales = ViewBag.RecentSales as List<PDMS.Models.Sale>;
                }
                @if (recentSales != null && recentSales.Count > 0)
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Sale #</th><th>Customer</th>
                                @if (isAdmin) { <th>Staff</th> }
                                <th>Date</th><th>Net Amount</th><th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in recentSales)
                            {
                                decimal net = (decimal?)s.NetAmount ?? 0m;
                                <tr>
                                    <td>#@s.SaleID</td>
                                    <td>@s.Customer?.Name</td>
                                    @if (isAdmin) { <td>@s.User?.FullName</td> }
                                    <td>@s.SaleDate.ToString("yyyy-MM-dd")</td>
                                    <td>Rs. @net.ToString("N2")</td>
                                    <td>
                                        @if (s.PaymentStatus == "Paid")
                                        { <span class="badge badge-ok">Paid</span> }
                                        else
                                        { <span class="badge badge-low">Pending</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">No sales found.</p>
                }
            </div>
        </div>
    </div>
</div>
