@model PDMS.Models.Warehouse
@{ ViewData["Title"] = "Delete Warehouse"; }
<div class="page-title text-danger"><i class="bi bi-trash me-2"></i>Delete Warehouse</div>
<div class="card" style="max-width:500px;"><div class="card-body">
    <div class="alert alert-danger">Delete <strong>@Model.Name</strong>?</div>
    <form asp-action="Delete"><input type="hidden" asp-for="WarehouseID" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>
