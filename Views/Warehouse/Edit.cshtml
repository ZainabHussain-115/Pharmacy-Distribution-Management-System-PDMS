@model PDMS.Models.Warehouse
@{ ViewData["Title"] = "Edit Warehouse"; }

<div class="page-title"><i class="bi bi-pencil me-2"></i>Edit Warehouse</div>
<div class="card" style="max-width:550px;">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" asp-for="WarehouseID" />
            <div class="mb-3"><label asp-for="Name"          class="form-label fw-semibold"></label><input asp-for="Name"          class="form-control" /></div>
            <div class="mb-3"><label asp-for="Location"      class="form-label fw-semibold"></label><input asp-for="Location"      class="form-control" /></div>
            <div class="mb-3"><label asp-for="Capacity"      class="form-label fw-semibold"></label><input asp-for="Capacity"      class="form-control" type="number" /></div>
            <div class="mb-3"><label asp-for="ManagerName"   class="form-label fw-semibold"></label><input asp-for="ManagerName"   class="form-control" /></div>
            <div class="mb-4"><label asp-for="ContactNumber" class="form-label fw-semibold"></label><input asp-for="ContactNumber" class="form-control" /></div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Update</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
