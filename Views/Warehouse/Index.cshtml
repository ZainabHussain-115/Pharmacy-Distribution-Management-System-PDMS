@model IEnumerable<PDMS.Models.Warehouse>
@{ ViewData["Title"] = "Warehouses"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="page-title mb-0"><i class="bi bi-box-seam me-2"></i>Warehouses</div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Warehouse</a>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead><tr><th>#</th><th>Name</th><th>Location</th><th>Capacity</th><th>Manager</th><th>Contact</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var w in Model)
                {
                    <tr>
                        <td>@w.WarehouseID</td>
                        <td class="fw-semibold">@w.Name</td>
                        <td>@w.Location</td>
                        <td>@w.Capacity</td>
                        <td>@w.ManagerName</td>
                        <td>@w.ContactNumber</td>
                        <td>
                            <a asp-action="Stock"  asp-route-id="@w.WarehouseID" class="btn btn-outline-success  btn-action me-1" title="View Stock"><i class="bi bi-boxes"></i></a>
                            <a asp-action="Edit"   asp-route-id="@w.WarehouseID" class="btn btn-outline-primary  btn-action me-1" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@w.WarehouseID" class="btn btn-outline-danger   btn-action"      title="Delete"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No warehouses yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
