@model PDMS.Models.Manufacturer
@{ ViewData["Title"] = "Delete Manufacturer"; }

<div class="page-title text-danger"><i class="bi bi-trash me-2"></i>Delete Manufacturer</div>

<div class="card" style="max-width:500px;">
    <div class="card-body">
        <div class="alert alert-danger">Are you sure you want to delete <strong>@Model.Name</strong>?</div>
        <dl class="row">
            <dt class="col-sm-4">Name</dt>       <dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">License No</dt> <dd class="col-sm-8">@Model.LicenseNumber</dd>
            <dt class="col-sm-4">Phone</dt>      <dd class="col-sm-8">@Model.Phone</dd>
        </dl>
        <form asp-action="Delete">
            <input type="hidden" asp-for="ManufacturerID" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Yes, Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
