@model IEnumerable<PDMS.Models.Manufacturer>
@{ ViewData["Title"] = "Manufacturers"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="page-title mb-0"><i class="bi bi-building me-2"></i>Manufacturers</div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Manufacturer</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th><th>Name</th><th>Contact Person</th><th>Phone</th><th>Email</th><th>License No</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.ManufacturerID</td>
                        <td class="fw-semibold">@m.Name</td>
                        <td>@m.ContactPerson</td>
                        <td>@m.Phone</td>
                        <td>@m.Email</td>
                        <td>@m.LicenseNumber</td>
                        <td>
                            <a asp-action="Edit"   asp-route-id="@m.ManufacturerID" class="btn btn-outline-primary btn-action me-1"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@m.ManufacturerID" class="btn btn-outline-danger  btn-action"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No manufacturers added yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
