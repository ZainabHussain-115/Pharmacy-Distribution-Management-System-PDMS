@model PDMS.Models.Manufacturer
@{ ViewData["Title"] = "Edit Manufacturer"; }

<div class="page-title"><i class="bi bi-pencil me-2"></i>Edit Manufacturer</div>

<div class="card" style="max-width:600px;">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" asp-for="ManufacturerID" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ContactPerson" class="form-label fw-semibold"></label>
                <input asp-for="ContactPerson" class="form-control" />
            </div>
            <div class="row">
                <div class="col mb-3">
                    <label asp-for="Phone" class="form-label fw-semibold"></label>
                    <input asp-for="Phone" class="form-control" />
                </div>
                <div class="col mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" type="email" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Address" class="form-label fw-semibold"></label>
                <input asp-for="Address" class="form-control" />
            </div>
            <div class="mb-4">
                <label asp-for="LicenseNumber" class="form-label fw-semibold"></label>
                <input asp-for="LicenseNumber" class="form-control" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Update</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
