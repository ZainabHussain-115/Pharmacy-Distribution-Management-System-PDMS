@model PDMS.Models.Customer
@{ ViewData["Title"] = "Add Customer"; }

<div class="page-title"><i class="bi bi-person-plus me-2"></i>Add Customer</div>
<div class="card" style="max-width:600px;"><div class="card-body">
    <form asp-action="Create">
        <div class="mb-3"><label asp-for="Name"          class="form-label fw-semibold"></label><input asp-for="Name"          class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="PhoneNumber"   class="form-label fw-semibold"></label><input asp-for="PhoneNumber"   class="form-control" /></div>
        <div class="mb-3"><label asp-for="Address"       class="form-label fw-semibold"></label><input asp-for="Address"       class="form-control" /></div>
        <div class="mb-3"><label asp-for="LicenseNumber" class="form-label fw-semibold"></label><input asp-for="LicenseNumber" class="form-control" placeholder="e.g. CUST-001" /></div>
        <div class="mb-4"><label asp-for="CreditLimit"   class="form-label fw-semibold"></label><input asp-for="CreditLimit"   class="form-control" type="number" step="0.01" /></div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>
