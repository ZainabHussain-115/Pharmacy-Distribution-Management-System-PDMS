@model IEnumerable<PDMS.Models.Customer>
@{ ViewData["Title"] = "Customers"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="page-title mb-0"><i class="bi bi-people me-2"></i>Customers</div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Customer</a>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead><tr><th>#</th><th>Name</th><th>Phone</th><th>Address</th><th>License No</th><th>Credit Limit</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.CustomerID</td>
                        <td class="fw-semibold">@c.Name</td>
                        <td>@c.PhoneNumber</td>
                        <td>@c.Address</td>
                        <td>@c.LicenseNumber</td>
                        <td>Rs. @c.CreditLimit?.ToString("N0")</td>
                        <td>
                            <a asp-action="Edit"   asp-route-id="@c.CustomerID" class="btn btn-outline-primary btn-action me-1"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@c.CustomerID" class="btn btn-outline-danger  btn-action"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No customers yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
