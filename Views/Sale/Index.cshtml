@model IEnumerable<PDMS.Models.Sale>
@{ ViewData["Title"] = "Sales"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="page-title mb-0"><i class="bi bi-receipt me-2"></i>Sales</div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Sale</a>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Sale #</th><th>Customer</th><th>Date</th><th>Net Amount</th>
                    <th>Method</th><th>Status</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    decimal net = (decimal?)s.NetAmount ?? 0m;
                    <tr>
                        <td class="fw-bold">#@s.SaleID</td>
                        <td>@s.Customer?.Name</td>
                        <td>@s.SaleDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="fw-semibold">Rs. @net.ToString("N2")</td>
                        <td>@s.PaymentMethod</td>
                        <td>
                            @if (s.PaymentStatus == "Paid")
                            { <span class="badge badge-ok">Paid</span> }
                            else
                            { <span class="badge badge-low">Pending</span> }
                        </td>
                        <td>
                            <a asp-action="Details"      asp-route-id="@s.SaleID"
                               class="btn btn-outline-info btn-action me-1" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="UpdateStatus" asp-route-id="@s.SaleID"
                               class="btn btn-outline-warning btn-action me-1" title="Update Payment Status">
                                <i class="bi bi-credit-card"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@s.SaleID"
                               class="btn btn-outline-danger btn-action" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                { <tr><td colspan="7" class="text-center text-muted py-4">No sales yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
