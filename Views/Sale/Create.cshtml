@model PDMS.Models.Sale
@{ ViewData["Title"] = "New Sale"; }

<div class="page-title"><i class="bi bi-receipt me-2"></i>Create New Sale</div>

<div asp-validation-summary="All" class="alert alert-danger" id="val-summary" style="display:none"></div>

<form asp-action="Create" method="post" id="saleForm">
<div class="row g-3">
    <!-- Left: sale header -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">Sale Details</div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="CustomerID" class="form-label fw-semibold">Customer</label>
                    <select asp-for="CustomerID" asp-items="ViewBag.Customers" class="form-select">
                        <option value="">-- Select Customer --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="CreatedBy" class="form-label fw-semibold">Staff</label>
                    <select asp-for="CreatedBy" asp-items="ViewBag.Users" class="form-select">
                        <option value="">-- Select Staff --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="PaymentMethod" class="form-label fw-semibold">Payment Method</label>
                    <select asp-for="PaymentMethod" class="form-select">
                        <option>Cash</option><option>Credit</option><option>Bank Transfer</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="PaymentStatus" class="form-label fw-semibold">Payment Status</label>
                    <select asp-for="PaymentStatus" class="form-select">
                        <option>Paid</option><option>Pending</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="Discount" class="form-label fw-semibold">Discount (Rs.)</label>
                    <input asp-for="Discount" class="form-control" type="number" step="0.01" value="0" id="discountInput" oninput="recalculate()" />
                </div>
                <div class="mb-3">
                    <label asp-for="TaxAmount" class="form-label fw-semibold">Tax (Rs.)</label>
                    <input asp-for="TaxAmount" class="form-control" type="number" step="0.01" value="0" id="taxInput" oninput="recalculate()" />
                </div>
                <hr>
                <div class="d-flex justify-content-between"><span class="text-muted">Total</span>  <strong id="lblTotal">Rs. 0.00</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted">Discount</span><strong id="lblDiscount">Rs. 0.00</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted">Tax</span>     <strong id="lblTax">Rs. 0.00</strong></div>
                <hr>
                <div class="d-flex justify-content-between fs-5"><span class="fw-bold">Net Amount</span><strong class="text-success" id="lblNet">Rs. 0.00</strong></div>
            </div>
        </div>
    </div>

    <!-- Right: medicine rows -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Medicines</span>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="addRow()"><i class="bi bi-plus-lg me-1"></i>Add Medicine</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0" id="itemsTable">
                    <thead><tr><th>Batch (Medicine | Stock | Expiry | Price)</th><th style="width:100px">Qty</th><th style="width:110px">Subtotal</th><th></th></tr></thead>
                    <tbody id="itemsBody">
                        <!-- rows added by JS -->
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-success btn-lg"><i class="bi bi-check-lg me-1"></i>Confirm Sale</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancel</a>
        </div>
    </div>
</div>
</form>

@section Scripts {
<script>
// Batch data passed from ViewBag (we rebuild the select options client-side for dynamic rows)
const batchOptions = `@Html.Raw(string.Join("", ((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Batches).Select(x => $"<option value='{x.Value}'>{x.Text}</option>")))`;

let rowCount = 0;

function addRow() {
    rowCount++;
    const tr = document.createElement('tr');
    tr.id = 'row' + rowCount;
    tr.innerHTML = `
        <td>
            <select name="BatchIDs" class="form-select form-select-sm batch-sel" onchange="updateSubtotal(${rowCount})">
                <option value="">-- Select Batch --</option>
                ${batchOptions}
            </select>
        </td>
        <td>
            <input type="number" name="Quantities" class="form-control form-control-sm qty-inp"
                   value="1" min="1" oninput="updateSubtotal(${rowCount})" data-row="${rowCount}" />
        </td>
        <td><span id="sub${rowCount}" class="fw-semibold">Rs. 0.00</span></td>
        <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="removeRow(${rowCount})"><i class="bi bi-x"></i></button></td>`;
    document.getElementById('itemsBody').appendChild(tr);
}

function removeRow(id) {
    const row = document.getElementById('row' + id);
    if (row) row.remove();
    recalculate();
}

// Extract price from the display text "... | Price: Rs.XX"
function getPriceFromOption(selectEl) {
    const text = selectEl.options[selectEl.selectedIndex]?.text || '';
    const match = text.match(/Price: Rs\.([\d.]+)/);
    return match ? parseFloat(match[1]) : 0;
}

function updateSubtotal(id) {
    const sel = document.querySelector(`#row${id} .batch-sel`);
    const qty = parseInt(document.querySelector(`#row${id} .qty-inp`).value) || 0;
    const price = getPriceFromOption(sel);
    const sub = price * qty;
    document.getElementById('sub' + id).textContent = 'Rs. ' + sub.toFixed(2);
    recalculate();
}

function recalculate() {
    let total = 0;
    document.querySelectorAll('[id^="sub"]').forEach(el => {
        total += parseFloat(el.textContent.replace('Rs. ', '')) || 0;
    });
    const discount = parseFloat(document.getElementById('discountInput').value) || 0;
    const tax      = parseFloat(document.getElementById('taxInput').value) || 0;
    const net      = total - discount + tax;

    document.getElementById('lblTotal').textContent    = 'Rs. ' + total.toFixed(2);
    document.getElementById('lblDiscount').textContent = 'Rs. ' + discount.toFixed(2);
    document.getElementById('lblTax').textContent      = 'Rs. ' + tax.toFixed(2);
    document.getElementById('lblNet').textContent      = 'Rs. ' + net.toFixed(2);
}

// Add first row on load
addRow();
</script>
}
