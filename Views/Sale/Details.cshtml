@model PDMS.Models.Sale
@{ ViewData["Title"] = "Sale Details"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="page-title mb-0"><i class="bi bi-receipt me-2"></i>Sale #@Model.SaleID</div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Back to Sales</a>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card"><div class="card-body">
            <h6 class="text-muted mb-3">Sale Info</h6>
            <dl class="row mb-0">
                <dt class="col-5">Customer</dt>  <dd class="col-7">@Model.Customer?.Name</dd>
                <dt class="col-5">Date</dt>       <dd class="col-7">@Model.SaleDate.ToString("yyyy-MM-dd HH:mm")</dd>
                <dt class="col-5">Staff</dt>      <dd class="col-7">@Model.User?.FullName</dd>
                <dt class="col-5">Method</dt>     <dd class="col-7">@Model.PaymentMethod</dd>
                <dt class="col-5">Status</dt>     <dd class="col-7">
                    @if (Model.PaymentStatus == "Paid")
                    { <span class="badge badge-ok">Paid</span> }
                    else { <span class="badge badge-low">Pending</span> }
                </dd>
                <dt class="col-5">Total</dt>      <dd class="col-7">Rs. @Model.TotalAmount?.ToString("N2")</dd>
                <dt class="col-5">Discount</dt>   <dd class="col-7">Rs. @Model.Discount.ToString("N2")</dd>
                <dt class="col-5">Tax</dt>        <dd class="col-7">Rs. @Model.TaxAmount.ToString("N2")</dd>
                <dt class="col-5 fw-bold">Net</dt><dd class="col-7 fw-bold text-success fs-5">Rs. @Model.NetAmount?.ToString("N2")</dd>
            </dl>
        </div></div>
    </div>
    <div class="col-md-8">
        <div class="card"><div class="card-body p-0">
            <table class="table mb-0">
                <thead><tr><th>Medicine</th><th>Batch</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th></tr></thead>
                <tbody>
                    @foreach (var sd in Model.SaleDetails)
                    {
                        <tr>
                            <td>@sd.Batch?.Medicine?.Name</td>
                            <td>@sd.Batch?.BatchNumber</td>
                            <td>@sd.QuantitySold</td>
                            <td>Rs. @sd.UnitPrice?.ToString("N2")</td>
                            <td class="fw-semibold">Rs. @sd.SubTotal?.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div></div>
    </div>
</div>
