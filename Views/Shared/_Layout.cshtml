<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PDMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <style>
        body { background: #f8f9fa; }
        .sidebar { min-height: 100vh; background: #1a1f2e; padding-top: 1rem; width: 230px; min-width: 230px; }
        .sidebar .brand { color: #fff; font-size: 1.2rem; font-weight: 700; padding: 1rem 1.5rem 1.5rem; border-bottom: 1px solid #2d3348; display: block; text-decoration: none; }
        .sidebar .brand span { color: #4e9af1; }
        .sidebar .nav-link { color: #a0aec0; padding: .6rem 1.5rem; display: flex; align-items: center; gap: .6rem; text-decoration: none; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background: #2d3348; color: #fff; }
        .sidebar .nav-section { color: #4a5568; font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; padding: 1rem 1.5rem .3rem; }
        .sidebar .admin-only-link { border-left: 2px solid #f6ad55; }
        .sidebar .admin-only-link:hover { border-left-color: #ed8936; }
        .main-content { padding: 2rem; flex: 1; }
        .page-title { font-size: 1.4rem; font-weight: 600; margin-bottom: 1.5rem; color: #1a202c; }
        .card { border: none; box-shadow: 0 1px 4px rgba(0,0,0,.08); border-radius: .75rem; }
        .table th { background: #f1f5f9; font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; color: #64748b; }
        .btn-action { padding: .25rem .6rem; font-size: .8rem; }
        .badge-expired { background: #fee2e2; color: #991b1b; }
        .badge-ok      { background: #dcfce7; color: #166534; }
        .badge-low     { background: #fef9c3; color: #854d0e; }
        .role-badge    { font-size: 10px; padding: 2px 8px; border-radius: 99px; margin-left: 6px; }
        .role-admin    { background: #fef3c7; color: #92400e; }
        .role-staff    { background: #dbeafe; color: #1e40af; }
        .user-info     { padding: .8rem 1.5rem; border-top: 1px solid #2d3348; margin-top: auto; }
        .user-name     { color: #fff; font-size: .85rem; font-weight: 500; }
        .user-role     { color: #718096; font-size: .72rem; }
        .lock-icon     { font-size: .6rem; margin-left: 4px; opacity: .5; }
    </style>
</head>
<body>
@{
    string currentRole     = Context.Session.GetString("Role") ?? "Staff";
    bool   isAdmin         = currentRole == "Admin";
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string userName        = Context.Session.GetString("UserName") ?? "User";
}

<div class="d-flex">
    <!-- ── SIDEBAR ── -->
    <div class="sidebar d-flex flex-column">
        <a class="brand" asp-controller="Home" asp-action="Index">💊 <span>PD</span>MS</a>

        <!-- MAIN -->
        <div class="nav-section">Main</div>
        <a class="nav-link @(currentController=="Home"?"active":"")"
           asp-controller="Home" asp-action="Index">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>

        <!-- INVENTORY — Admin only for manage, all for view -->
        <div class="nav-section">
            Inventory
            @if (!isAdmin) { <span style="font-size:9px;color:#4a5568;"> (view only)</span> }
        </div>

        @if (isAdmin)
        {
            <a class="nav-link admin-only-link @(currentController=="Manufacturer"?"active":"")"
               asp-controller="Manufacturer" asp-action="Index">
                <i class="bi bi-building"></i> Manufacturers
                <i class="bi bi-shield-lock lock-icon"></i>
            </a>
            <a class="nav-link admin-only-link @(currentController=="Medicine"?"active":"")"
               asp-controller="Medicine" asp-action="Index">
                <i class="bi bi-capsule"></i> Medicines
                <i class="bi bi-shield-lock lock-icon"></i>
            </a>
            <a class="nav-link admin-only-link @(currentController=="Warehouse"?"active":"")"
               asp-controller="Warehouse" asp-action="Index">
                <i class="bi bi-box-seam"></i> Warehouses
                <i class="bi bi-shield-lock lock-icon"></i>
            </a>
        }

        <!-- Batch — both can view, staff can add -->
        <a class="nav-link @(currentController=="Batch"?"active":"")"
           asp-controller="Batch" asp-action="Index">
            <i class="bi bi-layers"></i> Batches
        </a>

        <!-- SALES -->
        <div class="nav-section">Sales</div>
        <a class="nav-link @(currentController=="Sale"?"active":"")"
           asp-controller="Sale" asp-action="Index">
            <i class="bi bi-receipt"></i> Sales
        </a>
        <a class="nav-link @(currentController=="Customer"?"active":"")"
           asp-controller="Customer" asp-action="Index">
            <i class="bi bi-people"></i> Customers
        </a>

        <!-- REPORTS -->
        <div class="nav-section">Reports</div>
        <a class="nav-link @(currentController=="Reports"&&ViewContext.RouteData.Values["action"]?.ToString()=="MedicineOfMonth"?"active":"")"
           asp-controller="Reports" asp-action="MedicineOfMonth">
            <i class="bi bi-trophy"></i> Medicine of Month
        </a>
        <a class="nav-link @(currentController=="Reports"&&ViewContext.RouteData.Values["action"]?.ToString()=="MonthlyRevenue"?"active":"")"
           asp-controller="Reports" asp-action="MonthlyRevenue">
            <i class="bi bi-graph-up"></i> Monthly Revenue
        </a>
        <a class="nav-link @(currentController=="Reports"&&ViewContext.RouteData.Values["action"]?.ToString()=="LowStock"?"active":"")"
           asp-controller="Reports" asp-action="LowStock">
            <i class="bi bi-exclamation-triangle"></i> Low Stock
        </a>
        <a class="nav-link @(currentController=="Reports"&&ViewContext.RouteData.Values["action"]?.ToString()=="ExpiryReport"?"active":"")"
           asp-controller="Reports" asp-action="ExpiryReport">
            <i class="bi bi-calendar-x"></i> Expiry Report
        </a>
        <a class="nav-link @(currentController=="Reports"&&ViewContext.RouteData.Values["action"]?.ToString()=="BestSelling"?"active":"")"
           asp-controller="Reports" asp-action="BestSelling">
            <i class="bi bi-bar-chart"></i> Best Selling
        </a>
        <a class="nav-link @(currentController=="Reports"&&ViewContext.RouteData.Values["action"]?.ToString()=="CustomerHistory"?"active":"")"
           asp-controller="Reports" asp-action="CustomerHistory">
            <i class="bi bi-person-lines-fill"></i> Customer History
        </a>

        @if (isAdmin)
        {
            <!-- ADMIN-ONLY REPORTS -->
            <a class="nav-link admin-only-link @(currentController=="Reports"&&ViewContext.RouteData.Values["action"]?.ToString()=="OverallProfit"?"active":"")"
               asp-controller="Reports" asp-action="OverallProfit">
                <i class="bi bi-cash-coin"></i> Profit Report
                <i class="bi bi-shield-lock lock-icon"></i>
            </a>
            <a class="nav-link admin-only-link @(currentController=="Reports"&&ViewContext.RouteData.Values["action"]?.ToString()=="CustomerOfMonth"?"active":"")"
               asp-controller="Reports" asp-action="CustomerOfMonth">
                <i class="bi bi-person-badge"></i> Customer of Month
                <i class="bi bi-shield-lock lock-icon"></i>
            </a>
            <a class="nav-link admin-only-link @(currentController=="Reports"&&ViewContext.RouteData.Values["action"]?.ToString()=="StockValuation"?"active":"")"
               asp-controller="Reports" asp-action="StockValuation">
                <i class="bi bi-bank"></i> Stock Valuation
                <i class="bi bi-shield-lock lock-icon"></i>
            </a>
            <a class="nav-link admin-only-link @(currentController=="Reports"&&ViewContext.RouteData.Values["action"]?.ToString()=="SalesByDate"?"active":"")"
               asp-controller="Reports" asp-action="SalesByDate">
                <i class="bi bi-calendar-range"></i> Sales by Date
                <i class="bi bi-shield-lock lock-icon"></i>
            </a>

            <!-- ADMIN PANEL -->
            <div class="nav-section">Admin Panel</div>
            <a class="nav-link admin-only-link @(currentController=="Auth"&&ViewContext.RouteData.Values["action"]?.ToString()=="ManageUsers"?"active":"")"
               asp-controller="Auth" asp-action="ManageUsers">
                <i class="bi bi-people-fill"></i> Manage Users
                <i class="bi bi-shield-lock lock-icon"></i>
            </a>
        }

        <!-- USER INFO at bottom -->
        <div class="mt-auto user-info">
            <div class="user-name">
                <i class="bi bi-person-circle me-1"></i>@userName
                @if (isAdmin)
                { <span class="role-badge role-admin">Admin</span> }
                else
                { <span class="role-badge role-staff">Staff</span> }
            </div>
            <div class="user-role mt-1">
                <a href="/Auth/Logout" class="text-danger" style="font-size:.75rem;text-decoration:none;">
                    <i class="bi bi-box-arrow-left me-1"></i>Logout
                </a>
            </div>
        </div>
    </div>

    <!-- ── MAIN CONTENT ── -->
    <div class="main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
